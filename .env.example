# Copie para .env e substitua os valores de exemplo por segredos locais.
DB_NAME=clube_reservas
DB_USER=app_user
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root

# Gere com: openssl rand -base64 32
JWT_SECRET=change_me_generate_a_secret

# Use true somente quando o acesso estiver configurado com HTTPS.
COOKIE_SECURE=false
